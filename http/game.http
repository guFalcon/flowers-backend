# flowers backend REST/SSE API.
# Run in IntelliJ or with the JetBrains HTTP client CLI against `./mvnw quarkus:dev`.
# To watch the harvest event, keep `curl -N http://localhost:8084/api/events` open while running
# the harvest requests (or run the events request below on its own).
# level-update events carry the level as a JSON object:
#   {"type":"level-update","level":{"aspect":…,"flowers":[…],"bees":[…],"yourBeeId":null}}

@host = http://localhost:8084
@playerId = http-client-player
@flowerId = flower-1

### Get the level for a player (registers the player's bee)
GET {{host}}/api/level/{{playerId}}

> {%
    client.test("level contains flowers and your bee", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.flowers.length > 0, "no flowers");
        client.assert(!!response.body.yourBeeId, "yourBeeId " + response.body.yourBeeId);
    });
%}

### Set the bee's target: publishes a level-update whose level contains the bee with this target
POST {{host}}/api/player/{{playerId}}/target
Content-Type: application/json

{"x": 0.25, "y": 0.75}

> {%
    client.test("target is accepted", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.status === "ok", "status " + response.body.status);
    });
%}

### Harvest an existing flower: yields honey and publishes {"type":"harvest","flowerId":…,"fill":0}
POST {{host}}/api/harvest/{{flowerId}}

> {%
    client.test("first harvest yields honey", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(!!response.body.flowerId, "flowerId " + response.body.flowerId);
        client.assert(response.body.honey > 0, "honey " + response.body.honey);
    });
%}

### Harvest the same flower again: it is empty, yields 0 and publishes no event
POST {{host}}/api/harvest/{{flowerId}}

> {%
    client.test("repeated harvest yields nothing", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.honey === 0, "honey " + response.body.honey);
    });
%}

### Harvest an unknown flower: yields 0 and publishes no event
POST {{host}}/api/harvest/no-such-flower

> {%
    client.test("unknown flower yields nothing", () => {
        client.assert(response.status === 200, "status " + response.status);
        client.assert(response.body.honey === 0, "honey " + response.body.honey);
    });
%}

### Event stream (text/event-stream): level-update every 3 s, harvest after a successful harvest
GET {{host}}/api/events
Accept: text/event-stream

> {%
    // client.test() is not evaluated inside a streaming callback; a thrown error fails the run
    response.body.onEachLine((line, unsubscribe) => {
        if (typeof line !== "string" || !line.startsWith("data:"))
            return;
        const data = JSON.parse(line.substring("data:".length));
        if (data.type !== "level-update")
            return;
        if (typeof data.level !== "object")
            throw new Error("level-update carries level as " + typeof data.level + ", expected an object");
        if (!(data.level.flowers.length > 0) || !Array.isArray(data.level.bees))
            throw new Error("level-update level lacks flowers or bees: " + JSON.stringify(data.level));
        unsubscribe();
    });
%}
