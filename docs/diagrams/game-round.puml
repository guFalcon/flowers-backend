@startuml game-round
!theme plain
skinparam defaultFontName sans-serif
skinparam sequenceMessageAlign left
title flowers — one game round (two players)

participant "Browser A" as A
participant "Browser B" as B
participant "flowers-backend" as S

== Join ==
A -> S : GET /api/events (SSE, stays open)
B -> S : GET /api/events (SSE, stays open)
A -> S : GET /api/level/{playerIdA}
note right of S : registers bee A if unknown
S -->> A : SSE level-update (all bees)
S -->> B : SSE level-update
S --> A : Level { flowers, bees, yourBeeId }
B -> S : GET /api/level/{playerIdB}
S -->> A : SSE level-update
S -->> B : SSE level-update
S --> B : Level { ..., yourBeeId }

== Fly ==
A -> A : click → animate own bee\n(duration from distance)
A -> S : POST /api/player/{playerIdA}/target {x, y}
note right of S : flight from the bee's current position,\narrival = now + max(5 s × distance, 0.2 s)
S --> A : { status: "ok" }
S -->> A : SSE level-update
S -->> B : SSE level-update
B -> B : animate bee A to its target

== Harvest ==
A -> A : flight time elapsed\n(no newer flight)
A -> S : POST /api/player/{playerIdA}/harvest
alt bee arrived (±500 ms) on a flower centre with fill > 0.1
  note right of S : flower fill set to 0,\nhoney of bee A += round(fill² × 1000)
  S -->> A : SSE harvest { flowerId, fill: 0 }
  S -->> B : SSE harvest { flowerId, fill: 0 }
  S --> A : { flowerId, gained > 0, total }
  A -> A : slurp, show total
else on a flower, but nothing gained (fill <= 0.1 or still in flight)
  S --> A : { flowerId, gained: 0, total }
  A -> A : bump
else off every flower (bare meadow)
  S --> A : { flowerId: null, gained: 0, total }
  note right of A : no sound, no vibration
end

loop every 1 s
  S -> S : flowers refill by their rate
end
loop every 3 s
  S -->> A : SSE level-update
  S -->> B : SSE level-update
end
loop every 10 s
  S -> S : remove bees inactive > 60 s
end

== Restart (admin) ==
A -> S : POST /api/admin/restart\nX-Admin-Token: <token>
note right of S : 403 without a valid token;\notherwise new flowers, honey reset to 0
S -->> A : SSE levelRestarted
S -->> B : SSE levelRestarted
S --> A : { status: "ok", message }
A -> S : GET /api/level/{playerIdA}
B -> S : GET /api/level/{playerIdB}
@enduml
